rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isDemoUser() {
      return request.auth != null;
    }

    function isDemoHousehold(householdId) {
      return isDemoUser() && householdId == 'demo-household';
    }

    match /households/{householdId} {
      allow read: if isDemoHousehold(householdId);
      allow write: if false;
    }

    match /households/{householdId}/devices/{deviceId} {
      allow read: if isDemoHousehold(householdId);
      allow update: if isDemoHousehold(householdId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'health', 'lastChangedSource', 'updatedAt', 'position'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['position'])
          || (request.resource.data.position.column is int
            && request.resource.data.position.row is int
            && request.resource.data.position.column >= 1
            && request.resource.data.position.row >= 1
            && request.resource.data.position.width is int
            && request.resource.data.position.height is int
            && request.resource.data.position.width >= 1
            && request.resource.data.position.height >= 1));
      allow update: if isDemoHousehold(householdId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['capabilities', 'updatedAt'])
        && resource.data.type == 'iron'
        && request.resource.data.capabilities.canToggle == resource.data.capabilities.canToggle
        && request.resource.data.capabilities.safetyMaxDurationMinutes is int
        && request.resource.data.capabilities.safetyMaxDurationMinutes >= 1
        && request.resource.data.capabilities.safetyMaxDurationMinutes <= 240;
      allow create, delete: if false;
    }

    match /households/{householdId}/floors/{floorId} {
      allow read: if isDemoHousehold(householdId);
      allow write: if false;
    }

    match /households/{householdId}/schedules/{scheduleId} {
      allow read: if isDemoHousehold(householdId);
      allow update: if isDemoHousehold(householdId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['startTime', 'endTime', 'days', 'enabled', 'timezone'])
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.days is list
        && request.resource.data.enabled is bool
        && request.resource.data.timezone == 'Asia/Colombo';
      allow create, delete: if false;
    }

    match /households/{householdId}/alerts/{alertId} {
      allow read: if isDemoHousehold(householdId);
      allow update: if isDemoHousehold(householdId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && resource.data.read != true
        && request.resource.data.read == true;
      allow create, delete: if false;
    }

    match /households/{householdId}/{collection}/{documentId} {
      allow read: if isDemoHousehold(householdId)
        && collection in ['schedules', 'alerts', 'usage', 'events', 'logs'];
      allow write: if false;
    }

    match /households/{householdId}/devices/{deviceId}/switches/{switchId} {
      allow read: if isDemoHousehold(householdId);
      allow update: if isDemoHousehold(householdId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);
      allow create, delete: if false;
    }
  }
}
