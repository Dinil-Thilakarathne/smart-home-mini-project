{
  "name": "smart-home-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@smart-home/mobile",
    "dev:simulator": "turbo run dev --filter=@smart-home/simulator",
    "dev:firebase": "firebase emulators:start",
